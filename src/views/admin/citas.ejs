<%- include('../partials/header') %>
<h1 class="h3 text-primary fw-bold mb-3">Citas y vehículos</h1>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link <%= tab === 'citas' ? 'active' : '' %>" href="/admin/citas?tab=citas">Citas</a></li>
  <li class="nav-item"><a class="nav-link <%= tab === 'vehiculos' ? 'active' : '' %>" href="/admin/citas?tab=vehiculos">Vehículos</a></li>
</ul>

<% if (tab === 'citas') { %>
  <form class="row g-2 mb-3" method="get" action="/admin/citas">
    <input type="hidden" name="tab" value="citas">
    <div class="col-md-3">
      <select class="form-select" name="estatus" onchange="this.form.submit()" aria-label="Estatus">
        <option value="0">Todos los estatus</option>
        <% catEstatus.forEach(e => { %><option value="<%= e.id_estatus_cita %>" <%= estatus === e.id_estatus_cita ? 'selected' : '' %>><%= e.nombre %></option><% }) %>
      </select>
    </div>
    <div class="col-md-7"><input class="form-control" name="q" value="<%= q %>" placeholder="Buscar por cliente, vehículo o placas" aria-label="Buscar"></div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Buscar</button></div>
  </form>
  <div class="table-responsive">
    <table class="table table-striped tabla-azul align-middle small">
      <thead><tr><th>#</th><th>Fecha</th><th>Cliente / vehículo</th><th>Servicios</th><th>Mecánico</th><th>Estatus</th><th>Total</th><th>Acciones</th></tr></thead>
      <tbody>
        <% if (!citas.length) { %><tr><td colspan="8" class="text-center text-muted">Sin resultados.</td></tr><% } %>
        <% citas.forEach(c => { %>
          <tr class="<%= c.id_estatus_cita === 3 ? 'fila-inactiva' : '' %>">
            <td><%= c.id_cita %></td>
            <td class="text-nowrap"><%= c.fecha_hora.slice(0, 10) %><br><%= h.hora12(c.fecha_hora.slice(11)) %></td>
            <td><%= c.cliente %><br><span class="text-muted"><%= c.marca %> <%= c.modelo %> · <%= c.placas %></span></td>
            <td><%= c.servicios %><% if (c.llamada_solicitada) { %> <span class="badge text-bg-info">☎</span><% } %></td>
            <td>
              <% if (c.id_estatus_cita !== 3 && c.estatus_vehiculo !== 'Entregado') { %>
              <form class="d-flex gap-1" method="post" action="/admin/citas/<%= c.id_cita %>/mecanico">
                <select class="form-select form-select-sm" name="id_mecanico" aria-label="Mecánico">
                  <option value="">Sin asignar</option>
                  <% mecanicos.forEach(m => { %><option value="<%= m.id_usuario %>" <%= c.id_mecanico === m.id_usuario ? 'selected' : '' %>><%= m.nombre %> <%= m.apellidos %></option><% }) %>
                </select>
                <button class="btn btn-sm btn-primary">Asignar</button>
              </form>
              <% } else { %><%= (mecanicos.find(m => m.id_usuario === c.id_mecanico) || {}).nombre || '—' %><% } %>
            </td>
            <td><span class="badge text-bg-<%= c.id_estatus_cita === 3 ? 'secondary' : 'primary' %>"><%= c.estatus_cita %></span><br><span class="text-muted"><%= c.estatus_vehiculo %></span></td>
            <td><%= h.dinero(c.total) %></td>
            <td class="text-nowrap">
              <% if (c.id_estatus_cita === 1) { %>
                <form class="d-inline" method="post" action="/admin/citas/<%= c.id_cita %>/estatus"><input type="hidden" name="accion" value="confirmar"><button class="btn btn-sm btn-outline-success">Confirmar</button></form>
              <% } %>
              <% if (c.id_estatus_cita !== 3 && c.estatus_vehiculo !== 'Entregado') { %>
                <form class="d-inline" method="post" action="/admin/citas/<%= c.id_cita %>/estatus" onsubmit="return confirm('¿Cancelar esta cita?')"><input type="hidden" name="accion" value="cancelar"><button class="btn btn-sm btn-outline-danger">Cancelar</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="row g-4">
    <div class="col-xl-8">
      <form class="input-group mb-3" method="get" action="/admin/citas">
        <input type="hidden" name="tab" value="vehiculos">
        <input class="form-control" name="q" value="<%= q %>" placeholder="Buscar por vehículo, placas o dueño" aria-label="Buscar">
        <button class="btn btn-primary">Buscar</button>
      </form>
      <div class="table-responsive">
        <table class="table table-striped tabla-azul align-middle small">
          <thead><tr><th>ID</th><th>Vehículo</th><th>Placas</th><th>Dueño</th><th>Estado</th><th>Acciones</th></tr></thead>
          <tbody>
            <% if (!vehiculos.length) { %><tr><td colspan="6" class="text-center text-muted">Sin resultados.</td></tr><% } %>
            <% vehiculos.forEach(v => { %>
              <tr class="<%= v.activo ? '' : 'fila-inactiva' %>">
                <td><%= v.id_vehiculo %></td>
                <td><%= v.marca %> <%= v.modelo %> <%= v.anio %><% if (v.color) { %><br><span class="text-muted"><%= v.color %></span><% } %></td>
                <td><%= v.placas %></td>
                <td><%= v.dueno %></td>
                <td><span class="badge text-bg-<%= v.activo ? 'success' : 'secondary' %>"><%= v.activo ? 'Activo' : 'De baja' %></span></td>
                <td class="text-nowrap">
                  <a class="btn btn-sm btn-outline-primary" href="/admin/citas?tab=vehiculos&editar=<%= v.id_vehiculo %>">Editar</a>
                  <form class="d-inline" method="post" action="/admin/citas/vehiculos/<%= v.id_vehiculo %>/estado">
                    <button class="btn btn-sm btn-outline-<%= v.activo ? 'danger' : 'success' %>"><%= v.activo ? 'Dar de baja' : 'Reactivar' %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="col-xl-4">
      <div class="tarjeta-azul p-4">
        <h2 class="h5 text-center mb-3">Editar vehículo</h2>
        <% if (!editar) { %>
          <p class="mb-0 small">Elige un vehículo de la tabla con el botón Editar. Los vehículos los registran los clientes.</p>
        <% } else { %>
        <form method="post" action="/admin/citas/vehiculos/guardar" novalidate>
          <input type="hidden" name="id_vehiculo" value="<%= editar.id_vehiculo %>">
          <div class="row g-2">
            <div class="col-6"><label class="form-label">Marca</label><input class="form-control" name="marca" maxlength="40" value="<%= editar.marca %>" required></div>
            <div class="col-6"><label class="form-label">Modelo</label><input class="form-control" name="modelo" maxlength="40" value="<%= editar.modelo %>" required></div>
            <div class="col-4"><label class="form-label">Año</label><input class="form-control" name="anio" maxlength="4" value="<%= editar.anio %>" required></div>
            <div class="col-8"><label class="form-label">Placas</label><input class="form-control text-uppercase" name="placas" maxlength="15" value="<%= editar.placas %>" required></div>
            <div class="col-12"><label class="form-label">Color</label><input class="form-control" name="color" maxlength="30" value="<%= editar.color || '' %>"></div>
          </div>
          <div class="d-flex justify-content-center gap-2 mt-3">
            <button class="btn btn-dark">Guardar cambios</button>
            <a class="btn btn-outline-light" href="/admin/citas?tab=vehiculos">Cancelar</a>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
<%- include('../partials/footer') %>
