<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Taller Mecánico FIME</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/estilo.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
<% const activo = (p) => (path === p || (p !== '/' && path.startsWith(p)) ? 'active' : ''); %>
<nav class="navbar navbar-expand-lg navbar-dark barra">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">🔧 Taller Mecánico FIME</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Menú">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav me-auto">
        <% if (user && user.rol === 3) { %>
          <li class="nav-item"><a class="nav-link <%= activo('/admin/usuarios') %>" href="/admin/usuarios">CRUD Usuarios</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/admin/citas') %>" href="/admin/citas">CRUD Citas y Vehículos</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/admin/inventario') %>" href="/admin/inventario">CRUD Inventario</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/admin/servicios') %>" href="/admin/servicios">CRUD Servicios y Horarios</a></li>
        <% } else if (user && user.rol === 2) { %>
          <li class="nav-item"><a class="nav-link <%= activo('/mecanico/citas') %>" href="/mecanico/citas">Mis citas asignadas</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/mecanico/orden') %>" href="/mecanico/orden">Orden de trabajo</a></li>
          <li class="nav-item"><a class="nav-link" href="/mecanico/orden#refacciones">Consumo de refacciones</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/horarios') %>" href="/horarios">Horarios</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/servicios') %>" href="/servicios">Servicios</a></li>
          <li class="nav-item"><a class="nav-link <%= activo('/contacto') %>" href="/contacto">Contacto</a></li>
          <% if (user && user.rol === 1) { %>
            <li class="nav-item"><a class="nav-link <%= activo('/cliente/vehiculos') %>" href="/cliente/vehiculos">Mis vehículos y citas</a></li>
            <li class="nav-item"><a class="nav-link <%= activo('/cliente/seguimiento') %>" href="/cliente/seguimiento">Seguimiento y costo</a></li>
          <% } %>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-lg-center gap-lg-2">
        <% if (user) { %>
          <li class="nav-item"><a class="nav-link <%= activo('/cuenta') %>" href="/cuenta">Mi cuenta (<%= user.nombre %>)</a></li>
          <li class="nav-item">
            <form method="post" action="/logout"><button class="btn btn-outline-light btn-sm">Cerrar sesión</button></form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/registro">Crear cuenta</a></li>
          <li class="nav-item"><a class="btn btn-light btn-sm" href="/login">Iniciar sesión</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<main class="container py-4 flex-grow-1">
<% if (flash) { %>
  <div class="alert alert-<%= flash.tipo %> alert-dismissible fade show" role="alert">
    <%= flash.msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
  </div>
<% } %>
