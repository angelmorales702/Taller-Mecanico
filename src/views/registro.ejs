<%- include('partials/header') %>
<h1 class="h3 text-center mb-3">Crear cuenta</h1>
<div class="tarjeta-azul p-4 mx-auto" style="max-width:640px">
  <h2 class="h5 text-center mb-3">Captura tus datos</h2>
  <% if (errores.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <form method="post" action="/registro" class="row g-3" novalidate>
    <div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" maxlength="60" value="<%= form.nombre || '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="apellidos">Apellidos</label><input class="form-control" id="apellidos" name="apellidos" maxlength="80" value="<%= form.apellidos || '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="email">Correo</label><input type="email" class="form-control" id="email" name="email" maxlength="100" value="<%= form.email || '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="telefono">Teléfono (10 dígitos)</label><input class="form-control" id="telefono" name="telefono" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" value="<%= form.telefono || '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="usuario">Usuario</label><input class="form-control" id="usuario" name="usuario" maxlength="30" value="<%= form.usuario || '' %>" required></div>
    <div class="col-md-6"><label class="form-label" for="password">Contraseña (mín. 8)</label><input type="password" class="form-control" id="password" name="password" minlength="8" required></div>
    <div class="col-md-6"><label class="form-label" for="password2">Confirmar contraseña</label><input type="password" class="form-control" id="password2" name="password2" minlength="8" required></div>
    <div class="col-12 text-center"><button class="btn btn-dark px-5">Crear</button></div>
  </form>
</div>
<p class="text-center mt-3">¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
<%- include('partials/footer') %>
